<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Duhan Transport - Vehicle Register</title>
    <style>
        @page {
            size: A4 landscape;
            margin: 10mm;
            background-color: #121212;
        }
        *, *::before, *::after {
            box-sizing: border-box;
        }
        body {
            font-family: Arial, sans-serif;
            background-color: #121212;
            color: #ffffff;
            margin: 0;
            padding: 0;
            font-size: 9pt;
        }
        .header {
            display: table;
            width: 100%;
            border-bottom: 2px solid #28a745;
            padding-bottom: 10px;
            margin-bottom: 15px;
        }
        .header-title {
            display: table-cell;
            vertical-align: middle;
        }
        .header-title h1 {
            margin: 0;
            font-size: 18pt;
            color: #ffffff;
            text-transform: uppercase;
        }
        .header-title p {
            margin: 3px 0 0 0;
            color: #28a745;
            font-size: 10pt;
            font-weight: bold;
        }
        .header-meta {
            display: table-cell;
            text-align: right;
            vertical-align: middle;
            color: #aaaaaa;
            font-size: 8pt;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }
        th, td {
            padding: 6px 7px;
            border: 1px solid #333333;
            text-align: left;
            font-size: 8pt;
            vertical-align: middle;
        }
        th {
            background-color: #1e251f;
            color: #28a745;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 7.5pt;
        }
        tr:nth-child(even) td { background-color: #181818; }
        tr:nth-child(odd) td { background-color: #121212; }
        .rego {
            font-weight: bold;
            color: #ffffff;
            background-color: #222;
            padding: 2px 4px;
            border-radius: 3px;
            border: 1px solid #444;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="header-title">
            <h1>Duhan Transport</h1>
            <p>Official Fleet Vehicle Register — 2026</p>
        </div>
        <div class="header-meta">
            <div>Generated by: {{ user }}</div>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Type</th>
                <th>Rego</th>
                <th>Make</th>
                <th>Model</th>
                <th>Year</th>
                <th>Roadworthy Date</th>
                <th>VIN / Chassis No.</th>
                <th>GCM</th>
                <th>ATM</th>
                <th>PBS Permit #</th>
                <th>PBS Expiry</th>
                <th>Date Added</th>
            </tr>
        </thead>
        <tbody>
            {% for vehicle in vehicles %}
            <tr>
                <td>{{ vehicle.vehicle_type or '-' }}</td>
                <td><span class="rego">{{ vehicle.registration_number }}</span></td>
                <td>{{ vehicle.make or '-' }}</td>
                <td>{{ vehicle.model or '-' }}</td>
                <td>{{ vehicle.year or '-' }}</td>
                <td>{{ vehicle.last_roadworthy_date or '-' }}</td>
                <td>{{ vehicle.vin_chassis_no or '-' }}</td>
                <td>{{ vehicle.gcm_rating or '-' }}</td>
                <td>{{ vehicle.atm_rating or '-' }}</td>
                <td>{{ vehicle.pbs_permit_no or '-' }}</td>
                <td>{{ vehicle.pbs_expiry_date or '-' }}</td>
                <td>{{ vehicle.date_added or '-' }}</td>
            </tr>
            {% else %}
            <tr>
                <td colspan="12" style="text-align: center;">No vehicles registered.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</body>
</html>
